        <mxCell id="QZuBvwyN3mmVzLFFAjcx-797" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;u&gt;Легенда для Уровней риска&lt;/u&gt;:&lt;br&gt;&lt;br&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 204, 0);&quot;&gt;Незначительный&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(204, 204, 0);&quot;&gt;&lt;font style=&quot;color: rgb(153, 153, 0);&quot;&gt;Значительный&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(153, 0, 0);&quot;&gt;Критический&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
